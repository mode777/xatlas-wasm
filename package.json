{
  "name": "xatlas-wasm",
  "version": "0.1.3",
  "description": "xatlas UV atlas generation library compiled to WebAssembly",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "lib/xatlas.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./lib/xatlas.d.ts"
    }
  },
  "files": [
    "dist/index.mjs",
    "lib/xatlas.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "configure": "emcmake cmake -B build -DCMAKE_BUILD_TYPE=Release",
    "prebuild": "node scripts/ensure-configured.mjs",
    "build": "cmake --build build && npm run bundle",
    "bundle": "esbuild lib/xatlas.mjs --bundle --format=esm --outfile=dist/index.mjs --platform=node",
    "clean": "rm -rf build dist",
    "example": "npx serve . -l 3000 --no-clipboard",
    "test": "node test/test.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "keywords": [
    "xatlas",
    "uv",
    "atlas",
    "mesh",
    "wasm",
    "webassembly",
    "texture",
    "unwrap"
  ],
  "license": "MIT",
  "author": "alexander.klingenbeck@gmx.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/mode777/xatlas-wasm.git"
  },
  "homepage": "https://github.com/mode777/xatlas-wasm#readme",
  "bugs": {
    "url": "https://github.com/mode777/xatlas-wasm/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
